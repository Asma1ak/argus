# ================================
# Argus Server Configuration
# ================================

# Server
PORT=3001
NODE_ENV=development

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL required for Prisma 7)
DATABASE_URL="postgresql://user:password@localhost:5432/argus"
# For Render: Use the Internal Database URL from your PostgreSQL dashboard

# Database Pool (PostgreSQL only)
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=5000

# JWT Authentication
# SECURITY: Generate a strong secret for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4000
GROQ_TEMPERATURE=0.3
GROQ_TIMEOUT=30000
GROQ_MAX_RETRIES=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Analysis
MAX_TEXT_LENGTH=5000

# ================================
# Scalability Options
# ================================

# Redis (for distributed caching and rate limiting)
# Leave empty to use in-memory cache (single instance only)
REDIS_URL=
# REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=argus:
REDIS_TTL_ANALYSIS=86400
REDIS_TTL_USER=300
REDIS_TTL_TIER=60

# Cluster Mode (single server scaling)
# Use Kubernetes/Docker scaling instead when possible
CLUSTER_ENABLED=false
CLUSTER_WORKERS=0

# Job Queue (async analysis processing)
QUEUE_ENABLED=false
QUEUE_CONCURRENCY=5

# Metrics (Prometheus compatible)
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
