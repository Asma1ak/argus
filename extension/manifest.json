{
  "manifest_version": 3,
  "name": "Argus - Critical Thinking Assistant",
  "version": "1.0.1",
  "description": "Analyze any text for logical fallacies, cognitive biases, and manipulation tactics",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3001/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "128": "icons/icon.svg"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "argus@example.com",
      "strict_min_version": "109.0"
    }
  }
}
